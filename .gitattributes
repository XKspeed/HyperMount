# 统一换行，避免从 Windows 提交时把整份仓库改成 CRLF
# 模块脚本在 Android 上必须是 LF：CRLF 会让 #! 那行带上 \r，直接 "not found"
* text=auto eol=lf

*.sh   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.prop text eol=lf
*.json text eol=lf
*.xml  text eol=lf

# Windows 批处理必须是 CRLF，别跟着上面统一
*.bat  text eol=crlf

# 二进制不参与换行转换与文本 diff
*.png  binary
*.jpg  binary
*.webp binary
*.apk  binary
*.zip  binary
module/main/bin/* binary
