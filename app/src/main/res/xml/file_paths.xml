<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 能共享出去的路径：只需要 App 自己的更新包目录 -->
<paths>
    <external-files-path name="update" path="update/" />
    <files-path name="files" path="." />
    <!-- 快照导出：拿到所有文件权限时直接分享下载目录里那份 -->
    <external-path name="snapshot" path="Download/HyperMount快照/" />
    <!-- 没给权限时退回私有缓存里的副本 -->
    <cache-path name="share" path="share/" />
</paths>
